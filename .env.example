# --- CrowdSec Local API -------------------------------------------------------
LAPI_URL=http://127.0.0.1:8080

# Maschinen-Login für Alerts:
#   sudo cscli machines add crowdsec-dashboard --password '<passwort>' -f /dev/null
LAPI_MACHINE_ID=crowdsec-dashboard
LAPI_MACHINE_PASSWORD=

# Bouncer-Key für aktive Sperren:
#   sudo cscli bouncers add crowdsec-dashboard
LAPI_BOUNCER_KEY=

# Nur bei HTTPS-LAPI mit selbstsigniertem Zertifikat
LAPI_INSECURE_TLS=false

# --- Dashboard ----------------------------------------------------------------
LISTEN_HOST=127.0.0.1
LISTEN_PORT=3000
# Basic-Auth – unbedingt setzen, sobald das Dashboard nicht nur lokal erreichbar ist
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# Standort des Servers für das Radar (Default: Frankfurt)
HOME_LAT=50.11
HOME_LON=8.68
HOME_LABEL=FRA-01

# Max. Alerts pro Abruf und Cache-Dauer in Sekunden
ALERT_LIMIT=5000
CACHE_TTL=20

# Demo-Daten statt LAPI (zum Ausprobieren)
DEMO=false
